# Generate a new value for each environment; do not commit your real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False

# Compose reads these for its PostgreSQL container. Replace the sample password.
POSTGRES_DB=civiclens
POSTGRES_USER=civiclens
POSTGRES_PASSWORD=replace-this-local-example-password
